{
  "name": "visualize-karhutla",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build-downloads.ts && tsc --noEmit && vite build",
    "postbuild": "tsx scripts/build-og.ts",
    "preview": "vite preview",
    "images": "tsx scripts/optimize-images.ts",
    "scene": "tsx scripts/build-scene.ts",
    "downloads": "tsx scripts/build-downloads.ts",
    "boundaries": "tsx scripts/fetch-boundaries.ts",
    "sample": "tsx scripts/generate-sample.ts",
    "firms": "tsx scripts/process-firms.ts",
    "fetch-firms": "tsx scripts/fetch-firms.ts",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "deploy:pages": "cross-env DEPLOY_TARGET=pages npm run build && npx wrangler pages deploy dist --project-name visualize-karhutla --branch main",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.4.0",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@visx/curve": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "deck.gl": "^9.4.0",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^6.14.0",
    "marked": "^18.1.1",
    "motion": "^14.1.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "satori": "^0.48.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20.12"
  }
}
